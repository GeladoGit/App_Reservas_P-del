<script>
// ══════════════════════════════════════════════════════════════
// SUPABASE CONFIG
// ══════════════════════════════════════════════════════════════
const SB_URL = 'https://btpvrmdpnvpfwgmofhvt.supabase.co';
const SB_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ0cHZybWRwbnZwZndnbW9maHZ0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzYxOTcxNTcsImV4cCI6MjA5MTc3MzE1N30.Scm90uw6unnlYWO34spgU-AS2zqGR7dAAgLEQeYUZqI';

async function sbFetch(path, opts={}){
  const res = await fetch(`${SB_URL}/rest/v1/${path}`, {
    headers:{
      'apikey': SB_KEY,
      'Authorization': `Bearer ${SB_KEY}`,
      'Content-Type': 'application/json',
      'Prefer': opts.prefer !== undefined ? opts.prefer : 'return=representation',
      ...(opts.headers||{})
    },
    method: opts.method || 'GET',
    body: opts.body || undefined
  });
  if(!res.ok){
    const err = await res.text();
    throw new Error(`${res.status}: ${err}`);
  }
  const text = await res.text();
  return text ? JSON.parse(text) : null;
}

// BOOKINGS
async function sbGetBookings(){
  // Fetch all bookings for the next 3 days
  const keys = [0,1,2].map(i=>dayKey(i));
  const filter = keys.map(k=>`day_key.eq.${k}`).join(',');
  return await sbFetch(`bookings?or=(${filter})&order=hour.asc`) || [];
}
async function sbInsertBooking(bk){
  return await sbFetch('bookings', { method:'POST', body: JSON.stringify(bk) });
}
async function sbUpdateBooking(id, patch){
  return await sbFetch(`bookings?id=eq.${encodeURIComponent(id)}`, {
    method:'PATCH', body: JSON.stringify(patch), prefer:'return=representation'
  });
}
async function sbDeleteBooking(id){
  return await sbFetch(`bookings?id=eq.${encodeURIComponent(id)}`, { method:'DELETE', prefer:'' });
}

// BROADCASTS
async function sbGetBroadcasts(afterTs){
  return await sbFetch(`broadcasts?ts=gt.${afterTs}&order=ts.asc&limit=50`) || [];
}
async function sbInsertBroadcast(msg){
  return await sbFetch('broadcasts', {
    method:'POST',
    body: JSON.stringify({ msg, from_id: ME.id, ts: Date.now() })
  });
}

// ══════════════════════════════════════════════════════════════
// CONFIG
// ══════════════════════════════════════════════════════════════
const HOURS = ['08:00','09:00','10:00','11:00','12:00','13:00','14:00',
               '15:00','16:00','17:00','18:00','19:00','20:00','21:00'];
const DAYS_ES = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
const MON_ES  = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];

let ME = { street:'', num:'', piso:'', letra:'', label:'', id:'' };
let BOOKINGS = []; // array of booking objects from Supabase
let myNotifs = []; // stored in memory + shared via broadcasts
let lastBroadcastTs = 0;
let selectedDay = 0;

let _street='', _num='', _piso='', _letra='';
let pendingHour='', pendingDay=0, jugadoresVal=4, levelVal='', isOpen=false;
let _cancelId='';
let pollTimer=null;

// ══════════════════════════════════════════════════════════════
// HELPERS
// ══════════════════════════════════════════════════════════════
function dayKey(offset){
  const d=new Date(); d.setDate(d.getDate()+offset);
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}
function dateLabel(offset){
  const d=new Date(); d.setDate(d.getDate()+offset);
  return {dd:d.getDate(),dw:DAYS_ES[d.getDay()],full:`${DAYS_ES[d.getDay()]} ${d.getDate()} ${MON_ES[d.getMonth()]}`};
}
function isPast(offset,hour){
  const now=new Date(); const d=new Date(); d.setDate(d.getDate()+offset);
  const[h,m]=hour.split(':').map(Number); d.setHours(h,m,0,0); return d<=now;
}
function nextHour(h){const[hh]=h.split(':').map(Number);return`${String(hh+1).padStart(2,'0')}:00`;}
function bookingId(dk,h){return`${dk}_${h}`;}

function getBooking(offset,hour){
  const dk=dayKey(offset);
  return BOOKINGS.find(b=>b.day_key===dk&&b.hour===hour)||null;
}
function myBookingOnDay(offset){
  const dk=dayKey(offset);
  // Own booking OR a match you've joined
  return BOOKINGS.find(b=>b.day_key===dk&&(b.user_id===ME.id||b.joined.includes(ME.id)))||null;
}

// ══════════════════════════════════════════════════════════════
// LOGIN
// ══════════════════════════════════════════════════════════════
(function buildNums(){
  const row=document.getElementById('numRow');
  for(let i=1;i<=31;i++){
    const d=document.createElement('div');
    d.className='num-btn'; d.textContent=i;
    d.onclick=(function(n,el){return function(){
      _num=String(n);
      document.querySelectorAll('.num-btn').forEach(b=>b.classList.remove('sel'));
      el.classList.add('sel'); checkReady();
    };})(i,d);
    row.appendChild(d);
  }
})();

function selStreet(val,el){_street=val;document.querySelectorAll('.street-btn').forEach(b=>b.classList.remove('sel'));el.classList.add('sel');checkReady();}
function selPiso(val,el){_piso=val;document.querySelectorAll('.piso-btn').forEach(b=>b.classList.remove('sel'));el.classList.add('sel');updateDoorPreview();checkReady();}
function selLetra(val,el){_letra=val;document.querySelectorAll('.letra-btn').forEach(b=>b.classList.remove('sel'));el.classList.add('sel');updateDoorPreview();checkReady();}
function updateDoorPreview(){
  const p=document.getElementById('doorPreview');
  const ds=_piso==='Bajo'?`Bajo ${_letra}`:`${_piso}${_letra}`;
  if(_piso&&_letra)p.innerHTML=`Puerta: <b>${ds}</b>`;
  else if(_piso)p.innerHTML=`Piso: <b>${_piso==='Bajo'?'Bajo':_piso+'º'}</b> — falta letra`;
  else if(_letra)p.innerHTML=`Letra: <b>${_letra}</b> — falta piso`;
  else p.textContent='Selecciona piso y letra';
}
function checkReady(){document.getElementById('btnEnter').disabled=!(_street&&_num&&_piso&&_letra);}

async function doLogin(){
  const doorStr=_piso==='Bajo'?`Bajo ${_letra}`:`${_piso}${_letra}`;
  const label=`${_street} ${_num}, ${doorStr}`;
  ME={street:_street,num:_num,piso:_piso,letra:_letra,label,id:label.replace(/[\s,]/g,'_')};
  document.getElementById('loginScreen').style.display='none';
  document.getElementById('appShell').style.display='flex';
  document.getElementById('bottomNav').style.display='flex';
  document.getElementById('topbarUser').textContent=ME.label;

  // Load last seen broadcast ts from memory
  lastBroadcastTs = parseInt(sessionStorage.getItem('lbts_'+ME.id)||'0');

  showLoading('slotList');
  try {
    BOOKINGS = await sbGetBookings();
  } catch(e){
    console.error('Supabase error:', e.message);
    showToast('⚠️ ' + (e.message.includes('401')||e.message.includes('403') ? 'Error de autenticación — revisa la API key' : 'Error al cargar reservas: ' + e.message.slice(0,60)));
  }

  buildDateStrip(); buildSlots();
  await checkBroadcasts();
  startPolling();
}

function doLogout(){
  if(!confirm('¿Cerrar sesión?')) return;
  stopPolling();
  ME={street:'',num:'',piso:'',letra:'',label:'',id:''};
  _street='';_num='';_piso='';_letra='';BOOKINGS=[];myNotifs=[];
  document.getElementById('appShell').style.display='none';
  document.getElementById('bottomNav').style.display='none';
  document.getElementById('loginScreen').style.display='flex';
  document.querySelectorAll('.street-btn,.num-btn,.piso-btn,.letra-btn').forEach(b=>b.classList.remove('sel'));
  document.getElementById('doorPreview').textContent='Selecciona piso y letra';
  document.getElementById('btnEnter').disabled=true;
}

function showLoading(id){
  document.getElementById(id).innerHTML=`<div class="loading"><div class="spinner"></div>Cargando...</div>`;
}

// ══════════════════════════════════════════════════════════════
// DATE STRIP
// ══════════════════════════════════════════════════════════════
function buildDateStrip(){
  const strip=document.getElementById('dateStrip'); strip.innerHTML='';
  for(let i=0;i<3;i++){
    const{dd,dw}=dateLabel(i);
    const p=document.createElement('div');
    p.className='day-pill'+(i===selectedDay?' active':'');
    p.innerHTML=`<span class="dp-dd">${dd}</span><span class="dp-dw">${dw}</span>`;
    p.onclick=()=>{selectedDay=i;buildDateStrip();buildSlots();};
    strip.appendChild(p);
  }
}

// ══════════════════════════════════════════════════════════════
// SLOTS
// ══════════════════════════════════════════════════════════════
function buildSlots(){
  const list=document.getElementById('slotList'); list.innerHTML='';
  const myEntry=myBookingOnDay(selectedDay);

  HOURS.forEach(h=>{
    const bk=getBooking(selectedDay,h);
    const past=isPast(selectedDay,h);
    const isMine=bk&&bk.user_id===ME.id;
    const isJoined=bk&&!isMine&&bk.joined.includes(ME.id);
    const canBook=selectedDay<=2;

    let barClass,tagClass,tagText,detail,btnHTML;

    if(past){
      barClass='bar-past';tagClass='tag-past';tagText='Pasado';
      detail=bk?bk.label:'—';
      btnHTML=`<button class="slot-btn btn-dis" disabled>—</button>`;
    } else if(isMine){
      barClass='bar-mine';tagClass='tag-mine';tagText='Tu reserva';
      detail=`${bk.jugadores} jug.`+(bk.open?` · 🟢 abierto (${bk.joined.length}/${bk.jugadores})`:'');
      btnHTML=`<button class="slot-btn btn-can" data-id="${bk.id}" data-day="${selectedDay}">Cancelar</button>`;
    } else if(isJoined){
      barClass='bar-mine';tagClass='tag-mine';tagText='Te has apuntado';
      detail=`Partido de ${bk.label} · ${bk.jugadores} jug.`;
      btnHTML=`<button class="slot-btn btn-can" onclick="leaveMatch('${bk.id}')">Salir</button>`;
    } else if(bk){
      barClass='bar-occ';tagClass='tag-occ';tagText='Ocupado';
      detail=bk.label;
      btnHTML=`<button class="slot-btn btn-dis" disabled>Ocupado</button>`;
    } else {
      barClass='bar-free';tagClass='tag-free';tagText='Libre';detail='Disponible';
      if(!canBook) btnHTML=`<button class="slot-btn btn-dis" disabled>+48h</button>`;
      else if(myEntry) btnHTML=`<button class="slot-btn btn-dis" disabled>1/día</button>`;
      else btnHTML=`<button class="slot-btn btn-res" onclick="openModal('${h}',event)">Reservar</button>`;
    }

    const slot=document.createElement('div');
    slot.className=`slot${(!bk&&!past&&canBook&&!myEntry)?' free':''}`;
    slot.innerHTML=`
      <div class="slot-bar ${barClass}"></div>
      <div class="slot-time">${h}</div>
      <div class="slot-info">
        <div class="slot-tag ${tagClass}">${tagText} · hasta ${nextHour(h)}</div>
        <div class="slot-detail">${detail}</div>
      </div>${btnHTML}`;
    list.appendChild(slot);

    const cb=slot.querySelector('[data-id]');
    if(cb) cb.addEventListener('click',function(){
      _cancelId=this.dataset.id;
      document.getElementById('modalCancel').classList.add('open');
    });
  });
  updateNextCard();
  updateMatchBadge();
}

// ══════════════════════════════════════════════════════════════
// NEXT CARD
// ══════════════════════════════════════════════════════════════
function updateNextCard(){
  const card=document.getElementById('nextCard');
  const now=new Date(); let found=null;
  outer: for(let i=0;i<3;i++){
    const dk=dayKey(i);
    for(const h of HOURS){
      // Show card if: own booking OR joined someone else's open match
      const bk=BOOKINGS.find(b=>b.day_key===dk&&b.hour===h&&(b.user_id===ME.id||b.joined.includes(ME.id)));
      if(bk){
        const d=new Date(); d.setDate(d.getDate()+i);
        const[hh,mm]=h.split(':').map(Number); d.setHours(hh,mm,0,0);
        if(d>now){found={i,h,bk};break outer;}
      }
    }
  }
  if(found){
    const isOwn = found.bk.user_id===ME.id;
    document.getElementById('nextTime').textContent=`${found.h} – ${nextHour(found.h)}`;
    document.getElementById('nextDetail').textContent=
      isOwn
        ? `${dateLabel(found.i).full} · ${found.bk.jugadores} jugadores`
        : `${dateLabel(found.i).full} · Partido de ${found.bk.label}`;
    card.classList.add('show');
  } else card.classList.remove('show');
}

// ══════════════════════════════════════════════════════════════
// MODAL RESERVAR
// ══════════════════════════════════════════════════════════════
function openModal(h,e){
  e.stopPropagation();
  pendingHour=h; pendingDay=selectedDay;
  jugadoresVal=4; levelVal=''; isOpen=false;
  const{full}=dateLabel(selectedDay);
  document.getElementById('modalResSub').textContent=`${full} · ${h} – ${nextHour(h)}`;
  document.querySelectorAll('.opt-btn').forEach(b=>b.classList.remove('sel'));
  document.getElementById('jug4').classList.add('sel');
  document.getElementById('toggleOpen').checked=false;
  document.getElementById('toggleRow').style.display='none';
  document.getElementById('levelSection').style.display='none';
  document.querySelectorAll('.lv-btn').forEach(b=>b.className='lv-btn');
  document.getElementById('modalRes').classList.add('open');
}
function selJug(n,el){
  jugadoresVal=n;
  document.querySelectorAll('.opt-btn').forEach(b=>b.classList.remove('sel'));
  el.classList.add('sel');
  document.getElementById('toggleRow').style.display=n<4?'flex':'none';
  if(n>=4){isOpen=false;document.getElementById('toggleOpen').checked=false;document.getElementById('levelSection').style.display='none';levelVal='';}
}
function onToggleOpen(){
  isOpen=document.getElementById('toggleOpen').checked;
  document.getElementById('levelSection').style.display=isOpen?'block':'none';
  if(!isOpen){levelVal='';document.querySelectorAll('.lv-btn').forEach(b=>b.className='lv-btn');}
}
function selLevel(v,el){
  levelVal=v;
  document.querySelectorAll('.lv-btn').forEach(b=>b.className='lv-btn');
  el.className=`lv-btn sel ${v}`;
}

async function confirmBooking(){
  if(isOpen&&!levelVal){showToast('⚠️ Elige el nivel del partido');return;}
  closeModal('modalRes');
  showToast('⏳ Guardando reserva...');

  const dk=dayKey(pendingDay);
  const id=bookingId(dk,pendingHour);
  const bkData={
    id, day_key:dk, hour:pendingHour,
    user_id:ME.id, label:ME.label,
    jugadores:jugadoresVal, open:isOpen,
    level:levelVal, joined:isOpen?[ME.id]:[]
  };

  try {
    await sbInsertBooking(bkData);
    BOOKINGS.push(bkData);
    buildSlots();

    if(isOpen){
      const spotsNeeded = jugadoresVal - bkData.joined.length; // plazas que faltan = total - ya apuntados
      const lvText=levelVal?` · Nivel ${levelVal.charAt(0).toUpperCase()+levelVal.slice(1)}`:'';
      const{full}=dateLabel(pendingDay);
      const broadcastMsg=`⚡ Partido abierto · ${ME.label} busca ${spotsNeeded} jugador${spotsNeeded>1?'es':''} para el ${full} a las ${pendingHour}${lvText}. ¡Únete desde Partidos!`;
      await sbInsertBroadcast(broadcastMsg);
      document.getElementById('broadcastOkText').textContent=`${full} · ${pendingHour} – ${nextHour(pendingHour)} · ${jugadoresVal} jugadores`;
      document.getElementById('broadcastOkMsg').textContent=broadcastMsg;
      document.getElementById('modalBroadcastOk').classList.add('open');
    } else {
      showToast('✅ Pista reservada correctamente');
    }
  } catch(e){
    showToast('❌ Error al reservar. Inténtalo de nuevo.');
  }
}

// ══════════════════════════════════════════════════════════════
// CANCELAR
// ══════════════════════════════════════════════════════════════
async function doCancel(){
  closeModal('modalCancel');
  showToast('⏳ Cancelando...');
  const bk=BOOKINGS.find(b=>b.id===_cancelId);
  if(!bk){buildSlots();return;}
  const offset=BOOKINGS.indexOf(bk);
  const dk=bk.day_key;
  // Find dateLabel offset from dayKey
  let dayOff=0;
  for(let i=0;i<3;i++){if(dayKey(i)===dk){dayOff=i;break;}}
  const{full}=dateLabel(dayOff);

  try {
    await sbDeleteBooking(_cancelId);
    BOOKINGS=BOOKINGS.filter(b=>b.id!==_cancelId);

    // Broadcast
    const msg=bk.open
      ?`❌ Partido cancelado · ${ME.label} canceló su partido del ${full} a las ${bk.hour}. ¡Pista libre!`
      :`🔔 Pista libre · ${full} a las ${bk.hour} — ${ME.label} canceló su reserva`;
    await sbInsertBroadcast(msg);

    buildSlots();
    showToast('🗑 Reserva cancelada');
  } catch(e){
    showToast('❌ Error al cancelar');
  }
}

// ══════════════════════════════════════════════════════════════
// PARTIDOS ABIERTOS
// ══════════════════════════════════════════════════════════════
function buildMatches(){
  const list=document.getElementById('matchList'); list.innerHTML='';
  let count=0;
  const openBks=BOOKINGS.filter(b=>b.open&&b.joined.length<b.jugadores);
  // sort by day+hour
  openBks.sort((a,b)=>a.day_key.localeCompare(b.day_key)||a.hour.localeCompare(b.hour));

  openBks.forEach(bk=>{
    // find offset
    let dayOff=0;
    for(let i=0;i<3;i++){if(dayKey(i)===bk.day_key){dayOff=i;break;}}
    if(isPast(dayOff,bk.hour)) return;
    count++;
    const{full}=dateLabel(dayOff);
    const isMine=bk.user_id===ME.id;
    const iJoined=bk.joined.includes(ME.id);
    const spots=bk.jugadores-bk.joined.length;

    let playersHTML='';
    for(let s=0;s<bk.jugadores;s++){
      if(s<bk.joined.length){
        const pid=bk.joined[s];
        playersHTML+=`<div class="player-slot filled" title="${pid.replace(/_/g,' ')}">${pid===ME.id?'🙋':'👤'}</div>`;
      } else playersHTML+=`<div class="player-slot empty">➕</div>`;
    }

    let footerHTML='';
    if(isMine) footerHTML=`<span class="my-match-note">Es tu partido · ${spots} plaza${spots>1?'s':''} libre${spots>1?'s':''}</span>`;
    else if(iJoined) footerHTML=`<button class="btn-joined" onclick="leaveMatch('${bk.id}')">✓ Apuntado — Salir</button>`;
    else footerHTML=`<button class="btn-join" onclick="joinMatch('${bk.id}')">Unirme →</button>`;

    const mc=document.createElement('div');
    mc.className='match-card';
    mc.innerHTML=`
      <div class="match-header">
        <div><div class="match-time">${bk.hour} – ${nextHour(bk.hour)}</div><div class="match-date">${full}</div></div>
        <div class="level-badge level-${bk.level||'bajo'}">${(bk.level||'bajo').toUpperCase()}</div>
      </div>
      <div class="match-host">🏠 Organiza: ${bk.label}</div>
      <div class="players-row">${playersHTML}</div>
      <div class="match-footer">${footerHTML}</div>`;
    list.appendChild(mc);
  });

  if(count===0) list.innerHTML=`<div class="empty"><div class="empty-icon">🎾</div>No hay partidos abiertos.<br><br>Reserva una pista y activa <b style="color:var(--lime)">"Abrir partido"</b>.</div>`;

  const badge=document.getElementById('badgePartidos');
  if(count>0){badge.textContent=count;badge.classList.add('show');}
  else badge.classList.remove('show');
}

function updateMatchBadge(){
  let c=0;
  BOOKINGS.forEach(b=>{
    let off=0;
    for(let i=0;i<3;i++){if(dayKey(i)===b.day_key){off=i;break;}}
    if(b.open&&!isPast(off,b.hour)&&b.joined.length<b.jugadores) c++;
  });
  const badge=document.getElementById('badgePartidos');
  if(c>0){badge.textContent=c;badge.classList.add('show');}
  else badge.classList.remove('show');
}

async function joinMatch(id){
  const bk=BOOKINGS.find(b=>b.id===id);
  if(!bk||bk.joined.includes(ME.id)) return;
  const newJoined=[...bk.joined,ME.id];
  try {
    await sbUpdateBooking(id,{joined:newJoined});
    bk.joined=newJoined;
    // notify organiser via broadcast
    await sbInsertBroadcast(`🎾 ${ME.label} se ha unido al partido de ${bk.label} · ${bk.hour}`);
    buildMatches(); buildSlots();
    showToast('✅ ¡Te has unido!');
  } catch { showToast('❌ Error al unirse'); }
}
async function leaveMatch(id){
  const bk=BOOKINGS.find(b=>b.id===id);
  if(!bk) return;
  const newJoined=bk.joined.filter(u=>u!==ME.id);
  try {
    await sbUpdateBooking(id,{joined:newJoined});
    bk.joined=newJoined;
    buildMatches(); buildSlots();
    showToast('Saliste del partido');
  } catch { showToast('❌ Error'); }
}

// ══════════════════════════════════════════════════════════════
// BROADCASTS → NOTIFS
// ══════════════════════════════════════════════════════════════
async function checkBroadcasts(){
  try {
    const msgs=await sbGetBroadcasts(lastBroadcastTs);
    const newOnes=msgs.filter(m=>m.from_id!==ME.id);
    if(newOnes.length>0){
      newOnes.forEach(m=>{
        myNotifs.unshift({msg:m.msg,ts:m.ts,read:false});
      });
      lastBroadcastTs=Math.max(...msgs.map(m=>m.ts));
      try { sessionStorage.setItem('lbts_'+ME.id, String(lastBroadcastTs)); } catch{}
      renderNotifBadge();
    } else if(msgs.length>0){
      lastBroadcastTs=Math.max(...msgs.map(m=>m.ts));
      try { sessionStorage.setItem('lbts_'+ME.id, String(lastBroadcastTs)); } catch{}
    }
  } catch{}
}

// ══════════════════════════════════════════════════════════════
// NOTIFS RENDER
// ══════════════════════════════════════════════════════════════
function renderNotifBadge(){
  const unread=myNotifs.filter(n=>!n.read).length;
  const badge=document.getElementById('badgeNotifs');
  const dot=document.getElementById('notifDot');
  if(unread>0){badge.textContent=unread;badge.classList.add('show');dot.classList.add('show');}
  else{badge.classList.remove('show');dot.classList.remove('show');}
}
function renderNotifs(){
  const list=document.getElementById('notifList');
  if(!myNotifs.length){
    list.innerHTML=`<div class="empty"><div class="empty-icon">🔔</div>Sin notificaciones aún</div>`;return;
  }
  list.innerHTML=myNotifs.map(n=>{
    const icon=n.msg.startsWith('⚡')?'⚡':n.msg.startsWith('❌')?'❌':n.msg.startsWith('🗑')?'🗑':n.msg.startsWith('🔔')?'🔔':n.msg.startsWith('🎾')?'🎾':'📣';
    return`<div class="notif-item ${n.read?'':'notif-new'}">
      <div class="notif-icon">${icon}</div>
      <div style="flex:1;min-width:0">
        <div class="notif-text">${n.msg}</div>
        <div class="notif-time">${timeAgo(n.ts)}</div>
      </div></div>`;
  }).join('');
}
function markNotifsRead(){myNotifs.forEach(n=>n.read=true);renderNotifBadge();}
function timeAgo(ts){
  const s=Math.floor((Date.now()-ts)/1000);
  if(s<60)return'ahora';if(s<3600)return`hace ${Math.floor(s/60)} min`;
  if(s<86400)return`hace ${Math.floor(s/3600)} h`;return`hace ${Math.floor(s/86400)} días`;
}

// ══════════════════════════════════════════════════════════════
// NAV
// ══════════════════════════════════════════════════════════════
function goScreen(name){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  document.getElementById('sc'+name.charAt(0).toUpperCase()+name.slice(1)).classList.add('active');
  document.getElementById('nav-'+name).classList.add('active');
  if(name==='partidos') buildMatches();
  if(name==='notifs'){renderNotifs();markNotifsRead();}
}

// ══════════════════════════════════════════════════════════════
// POLLING — every 10s sync DB + check broadcasts
// ══════════════════════════════════════════════════════════════
function startPolling(){
  pollTimer=setInterval(async()=>{
    try {
      const fresh=await sbGetBookings();
      BOOKINGS=fresh;
      buildSlots();
      if(document.getElementById('scPartidos').classList.contains('active')) buildMatches();
    } catch{}
    await checkBroadcasts();
  },10000);
}
function stopPolling(){clearInterval(pollTimer);pollTimer=null;}

// ══════════════════════════════════════════════════════════════
// UTILS
// ══════════════════════════════════════════════════════════════
function closeModal(id){document.getElementById(id).classList.remove('open');}
function bgClose(e,id){if(e.target===document.getElementById(id))closeModal(id);}
let toastTimer;
function showToast(msg){
  const t=document.getElementById('toast');
  t.textContent=msg;t.classList.add('show');
  clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),3000);
}
</script>
